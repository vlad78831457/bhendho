# Скопируйте в .env и задайте значения. Реальные секреты в Git не коммитятся.
POSTGRES_DB=offgrid
POSTGRES_USER=offgrid
POSTGRES_PASSWORD=offgrid_dev  # только для локальной разработки
CORE_PORT=8080
# Секрет подписи access-JWT, минимум 32 байта: openssl rand -hex 32
JWT_SECRET=
# Каталог модулей (module.yaml + forms/) внутри контейнера ядра
CORE_MODULES_DIR=
# Разрешённые Origin браузеров для WebSocket, через запятую
CORE_WS_ORIGINS=
# Демо-пополнение «из воздуха» (ADR-26) — только для стендов
CORE_DEMO_DEPOSIT=false
# Прорабы из конфига (ADR-52): service:name:token, токен ≥ 32 символов (openssl rand -hex 32)
CORE_PRORAB_TOKENS=
